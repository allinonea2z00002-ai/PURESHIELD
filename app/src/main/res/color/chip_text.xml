<?xml version="1.0" encoding="utf-8"?>
<!-- Chip / day-pill text: selected = button text (white on mint), default = ink. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_selected="true"
        android:color="?attr/buttonText" />
    <item android:color="?attr/inkColor" />
</selector>
