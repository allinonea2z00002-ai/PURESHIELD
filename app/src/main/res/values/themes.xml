<?xml version="1.0" encoding="utf-8"?>
<!--
    PureShield themes — 6 FULL UI themes (colours + radii + fonts + layout flags).
    Each theme sets every custom attr from attrs.xml.
    ShapeAppearance styles use @dimen/... (never ?attr/... for sizes).
    Font mapping (demo web font -> closest Android SYSTEM family):
      Sora -> sans-serif | Quicksand -> sans-serif-light | Lora -> serif
      Zilla Slab -> serif | Manrope -> sans-serif | Jost -> sans-serif-light
      Orbitron -> monospace
    Plain Views needing rounded backgrounds must use MaterialCardView /
    MaterialButton with these shape appearances — a plain <shape> drawable
    cannot resolve ?attr/ radii at runtime.
-->
<resources>

    <!-- ============ ShapeAppearance: ORIGINAL (cyber-sharp) ============ -->
    <style name="ShapeAppearance.PureShield.Original.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/original_small_radius</item>
    </style>
    <style name="ShapeAppearance.PureShield.Original.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/original_card_radius</item>
