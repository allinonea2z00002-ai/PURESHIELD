<?xml version="1.0" encoding="utf-8"?>
<!-- Section title left border (demo .sec-title h3, Original theme only):
     a 3dp mint bar on the left edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="3dp"
        android:gravity="left">
        <shape android:shape="rectangle">
            <solid android:color="?attr/mintColor" />
        </shape>
    </item>
</layer-list>
