<?xml version="1.0" encoding="utf-8"?>
<!-- Jungle leaf card: 26dp / 8dp / 26dp / 8dp asymmetric corners.
     Solid uses ?attr/cardBackground (colour attrs DO resolve in drawables).
     Jungle-only: other themes use MaterialCardView + their ShapeAppearance. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/cardBackground" />
    <corners
        android:topLeftRadius="26dp"
        android:topRightRadius="8dp"
        android:bottomRightRadius="26dp"
        android:bottomLeftRadius="8dp" />
</shape>
