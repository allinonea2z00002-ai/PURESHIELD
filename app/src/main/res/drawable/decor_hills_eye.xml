<?xml version="1.0" encoding="utf-8"?>
<!-- EYE hills: very faint olive hills at 0.25 opacity (demo: hills opacity .25,
     sun/clouds hidden). Layered under decor_ruled by decor_eye.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item
        android:width="560dp"
        android:height="200dp"
        android:gravity="bottom|left"
        android:bottom="-110dp"
        android:left="-100dp">
        <shape android:shape="oval">
            <solid android:color="#40A3A077" />
        </shape>
    </item>
    <item
        android:width="560dp"
        android:height="200dp"
        android:gravity="bottom|right"
        android:bottom="-130dp"
        android:right="-120dp">
        <shape android:shape="oval">
            <solid android:color="#4075854E" />
        </shape>
    </item>
</layer-list>
