<?xml version="1.0" encoding="utf-8"?>
<!-- Zen avatar (demo: transparent + 1.5px mint border, mint-deep letter —
     the letter colour is set in code): circular, no fill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="?attr/mintColor" />
</shape>
