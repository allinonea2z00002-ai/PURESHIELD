<?xml version="1.0" encoding="utf-8"?>
<!-- Dawn avatar (demo: circular + white ring): accent2 -> mint-deep
     gradient with a 3dp white stroke standing in for the white ring shadow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="?attr/accent2"
        android:endColor="?attr/mintDeepColor" />
    <stroke
        android:width="3dp"
        android:color="#FFFFFF" />
</shape>
