<?xml version="1.0" encoding="utf-8"?>
<!-- Splash / drawer-header logo: same premium shield mark as the launcher
     foreground, drawn larger (x2.22) with a soft gold outer ring. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240">
    <!-- soft outer ring -->
    <path
        android:pathData="M120,8 m-104,0 a104,104 0 1,0 208,0 a104,104 0 1,0 -208,0"
        android:fillColor="#00000000"
        android:strokeColor="#F2C14E"
        android:strokeWidth="4"
        android:strokeAlpha="0.45" />
    <!-- shield (scaled x2.22 from the 108 foreground) -->
    <path
        android:pathData="M120,40 L187,62 L187,124 C187,164 160,187 120,200 C80,187 53,164 53,124 L53,62 Z"
        android:strokeColor="#053B2F"
        android:strokeWidth="4.5"
        android:strokeLineJoin="round">
        <gradient
            android:type="linear"
            android:startX="120"
            android:startY="40"
            android:endX="120"
            android:endY="200"
            android:startColor="#129C79"
            android:centerColor="#0A7A5C"
            android:endColor="#05473A" />
    </path>
    <!-- subtle top sheen following the shield roofline -->
    <path
        android:pathData="M120,40 L187,62 L187,89 L120,67 L53,89 L53,62 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.10" />
    <!-- gold hexagonal core ring -->
    <path
        android:pathData="M120,80 L158,102 L158,147 L120,169 L82,147 L82,102 Z"
        android:fillColor="#00000000"
        android:strokeColor="#F2C14E"
        android:strokeWidth="10"
        android:strokeLineJoin="round" />
    <!-- white checkmark -->
    <path
        android:pathData="M98,124 L113,140 L144,104"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="14.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
