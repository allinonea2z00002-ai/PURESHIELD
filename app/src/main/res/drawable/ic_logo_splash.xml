        android:pathData="M120,8 m-104,0 a104,104 0 1,0 208,0 a104,104 0 1,0 -208,0"
        android:fillColor="#00000000"
        android:strokeColor="#2F9E7E"
        android:strokeWidth="3"
        android:strokeAlpha="0.35" />
