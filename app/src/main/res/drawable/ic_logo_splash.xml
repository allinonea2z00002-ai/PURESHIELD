<?xml version="1.0" encoding="utf-8"?>
<!-- Splash / drawer-header logo: same lotus-shield mark as the launcher
     foreground, drawn larger with a soft outer ring. TRACED APPROXIMATION
     of the raster lotus logo — vector redraw, NOT pixel-identical. -->
