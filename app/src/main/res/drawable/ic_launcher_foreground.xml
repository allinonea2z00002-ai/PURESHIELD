<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon foreground: premium shield mark.
     Bold geometric shield in a deep emerald -> teal gradient, gold hexagonal
     ring at centre with a crisp white checkmark. No fine detail: reads clearly
     at small launcher sizes. All artwork inside the 72dp safe zone:
     shield spans x 24..84 / y 18..90 of the 108 viewport. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- shield -->
    <path
        android:pathData="M54,18 L84,28 L84,56 C84,74 72,84 54,90 C36,84 24,74 24,56 L24,28 Z"
        android:strokeColor="#053B2F"
        android:strokeWidth="2"
        android:strokeLineJoin="round">
        <gradient
            android:type="linear"
            android:startX="54"
            android:startY="18"
            android:endX="54"
            android:endY="90"
            android:startColor="#129C79"
            android:centerColor="#0A7A5C"
            android:endColor="#05473A" />
    </path>
    <!-- subtle top sheen following the shield roofline -->
    <path
        android:pathData="M54,18 L84,28 L84,40 L54,30 L24,40 L24,28 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.10" />
    <!-- gold hexagonal core ring -->
    <path
        android:pathData="M54,36 L71,46 L71,66 L54,76 L37,66 L37,46 Z"
        android:fillColor="#00000000"
        android:strokeColor="#F2C14E"
        android:strokeWidth="4.5"
        android:strokeLineJoin="round" />
    <!-- white checkmark -->
    <path
        android:pathData="M44,56 L51.5,63.5 L65,47"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
