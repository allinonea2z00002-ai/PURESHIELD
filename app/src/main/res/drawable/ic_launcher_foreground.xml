<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon foreground: lotus-shield mark (TRACED APPROXIMATION of the
     raster lotus logo — vector redraw, NOT pixel-identical).
     White shield with mint-deep outline, lavender 5-petal lotus at centre,
     mint base arc + centre dot. Keep the mark inside the 72dp safe zone:
     shield spans x 16..92 / y 6..102 of the 108 viewport. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- shield -->
    <path
        android:pathData="M54,6 L92,18 L92,54 C92,78 76,96 54,102 C32,96 16,78 16,54 L16,18 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.95"
        android:strokeColor="#1F7A5F"
        android:strokeWidth="3.5"
        android:strokeLineJoin="round" />
    <!-- lotus: far-left petal -->
    <path
        android:pathData="M32,50 C37,56 37,63 31,68 C27,61 27,55 32,50 Z"
        android:fillColor="#B8B0E8" />
    <!-- lotus: far-right petal -->
    <path
        android:pathData="M76,50 C81,55 81,61 77,68 C71,63 71,56 76,50 Z"
        android:fillColor="#B8B0E8" />
    <!-- lotus: left petal -->
    <path
        android:pathData="M42,42 C48,50 48,60 42,66 C37,58 37,50 42,42 Z"
        android:fillColor="#9A8AD0" />
    <!-- lotus: right petal -->
    <path
        android:pathData="M66,42 C71,50 71,58 66,66 C60,60 60,50 66,42 Z"
        android:fillColor="#9A8AD0" />
    <!-- lotus: centre petal -->
    <path
        android:pathData="M54,34 C59,44 59,56 54,64 C49,56 49,44 54,34 Z"
        android:fillColor="#7C6BB0" />
    <!-- lotus: base arc -->
    <path
        android:pathData="M36,68 C44,76 64,76 72,68 C64,73 44,73 36,68 Z"
        android:fillColor="#2F9E7E" />
    <!-- centre dot -->
    <path
        android:pathData="M54,74 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"
        android:fillColor="#2F9E7E" />
</vector>
