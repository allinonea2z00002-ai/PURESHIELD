<?xml version="1.0" encoding="utf-8"?>
<!-- Centre FAB: 4dp ring in the bar colour, inner gradient fabStart -> fabEnd. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/cardBackground" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:endColor="?attr/fabEnd"
                android:startColor="?attr/fabStart"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
