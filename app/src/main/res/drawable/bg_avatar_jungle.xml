<?xml version="1.0" encoding="utf-8"?>
<!-- Jungle avatar (demo leaf: 60% 8px): accent2 -> mint-deep gradient.
     60% of the 44dp avatar is ~26dp. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="?attr/accent2"
        android:endColor="?attr/mintDeepColor" />
    <corners
        android:topLeftRadius="26dp"
        android:topRightRadius="8dp"
        android:bottomRightRadius="26dp"
        android:bottomLeftRadius="8dp" />
</shape>
