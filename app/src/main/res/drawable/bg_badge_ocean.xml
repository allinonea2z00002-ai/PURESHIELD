<?xml version="1.0" encoding="utf-8"?>
<!-- Ocean ring-centre badge (demo: circular): tile gradient with a
     1px line border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="?attr/tileStart"
        android:endColor="?attr/tileEnd" />
    <stroke
        android:width="1dp"
        android:color="?attr/lineColor" />
</shape>
