<?xml version="1.0" encoding="utf-8"?>
<!-- Horizontal progress bar: line-colour track, gradient accent1 -> accent2 fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="?attr/lineColor" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:endColor="?attr/accent2"
                    android:startColor="?attr/accent1"
                    android:type="linear" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
