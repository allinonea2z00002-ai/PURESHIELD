<?xml version="1.0" encoding="utf-8"?>
<!-- Theme-picker dot, THIN-BORDER ROUND (Zen): transparent fill, thin
     outline. Shape only — tint at runtime with ShieldTheme.dotColors[i]
     (tint colours the stroke). -->
