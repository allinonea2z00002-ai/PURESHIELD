<?xml version="1.0" encoding="utf-8"?>
<!-- JUNGLE hills: warm sun + green hills at 0.85 opacity feel.
     Layered under decor_dots by decor_jungle.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#E9F4E1"
                android:endColor="#D7EAC4"
                android:type="linear" />
        </shape>
    </item>
    <!-- warm sun -->
    <item
        android:width="110dp"
        android:height="110dp"
        android:gravity="top|right"
        android:top="44dp"
        android:right="28dp">
        <shape android:shape="oval">
            <solid android:color="#F2C94C" />
        </shape>
    </item>
    <!-- hills (back) -->
    <item
        android:width="560dp"
        android:height="200dp"
        android:gravity="bottom|left"
        android:bottom="-110dp"
        android:left="-100dp">
        <shape android:shape="oval">
            <solid android:color="#D981C784" />
        </shape>
    </item>
    <!-- hills (front) -->
    <item
        android:width="560dp"
        android:height="200dp"
        android:gravity="bottom|right"
        android:bottom="-130dp"
        android:right="-120dp">
        <shape android:shape="oval">
            <solid android:color="#D966BB6A" />
        </shape>
    </item>
</layer-list>
