<?xml version="1.0" encoding="utf-8"?>
<!-- Zen ring-centre badge (demo: transparent + 1.5px line border, no
     animation): circular, no fill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="?attr/lineColor" />
</shape>
