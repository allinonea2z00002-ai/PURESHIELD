<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon background: soft mint -> lavender gradient, matching the
     Relax lotus logo (mint #D9F0E4 -> lavender #E6E0FF). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#D9F0E4"
        android:centerColor="#DDEBF2"
        android:endColor="#E6E0FF"
        android:type="linear" />
</shape>
