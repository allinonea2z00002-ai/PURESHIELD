<?xml version="1.0" encoding="utf-8"?>
<!-- Primary gradient button: buttonStart -> buttonEnd. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:endColor="?attr/buttonEnd"
        android:startColor="?attr/buttonStart"
        android:type="linear" />
    <corners android:radius="14dp" />
</shape>
