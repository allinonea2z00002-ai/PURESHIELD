<?xml version="1.0" encoding="utf-8"?>
<!-- Red-tinted lock banner background. Applied to a background-only View with
     android:alpha="0.12" so the tint stays light on every theme. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/redColor" />
    <corners android:radius="12dp" />
</shape>
