<?xml version="1.0" encoding="utf-8"?>
<!-- Custom-time input (Time Lock): cardBackground2 fill, 1dp line border, 13dp radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/cardBackground2" />
    <stroke
        android:width="1dp"
        android:color="?attr/lineColor" />
    <corners android:radius="13dp" />
</shape>
