<?xml version="1.0" encoding="utf-8"?>
<!-- Dawn ring-centre badge (demo: circular + 2px white border): tile
     gradient with a 2dp white stroke. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="?attr/tileStart"
        android:endColor="?attr/tileEnd" />
    <stroke
        android:width="2dp"
        android:color="#FFFFFF" />
</shape>
