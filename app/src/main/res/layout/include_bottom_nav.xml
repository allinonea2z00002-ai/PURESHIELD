<?xml version="1.0" encoding="utf-8"?>
<!-- Shared bottom nav (demo: floating bar, radius 26px, centre raised 58px shield FAB).
     Root is 90dp tall so the FAB (58dp) sits fully inside it: bar occupies the
     bottom 64dp, the FAB's top 26dp rise above the bar. No negative margins,
     so it works inside the vertical LinearLayout roots the other screens use.
     Bound by ui.BottomNav.bind(activity, binding, tab). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="12dp"
    android:clipChildren="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="26dp"
        app:cardBackgroundColor="?attr/cardBackground"
        app:cardCornerRadius="?attr/tabCornerRadius"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/homeIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_home"
                    app:tint="?attr/faintColor" />

                <TextView
                    android:id="@+id/homeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_home"
                    android:textColor="?attr/subColor"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navLocation"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/locationIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_pin"
                    app:tint="?attr/faintColor" />

                <TextView
                    android:id="@+id/locationLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_location"
                    android:textColor="?attr/subColor"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <Space
                android:layout_width="58dp"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/navBlock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/blockIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_block"
                    app:tint="?attr/faintColor" />

                <TextView
                    android:id="@+id/blockLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_block"
                    android:textColor="?attr/subColor"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navStats"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/statsIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chart"
                    app:tint="?attr/faintColor" />

                <TextView
                    android:id="@+id/statsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_stats"
                    android:textColor="?attr/subColor"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/fabTimeLock"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_fab"
        android:contentDescription="@string/nav_time_lock"
        android:elevation="8dp"
        android:padding="15dp"
        android:src="@drawable/ic_shield"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/fabText" />

</androidx.constraintlayout.widget.ConstraintLayout>
