<?xml version="1.0" encoding="utf-8"?>
<!-- Protection guard row: icon tile + title/sub + switch, with a divider
     underneath (demo .guards rows). The last row's divider is hidden in
     code. The icon tile background/tint are set in code (per-guard colour
     at ~13% alpha). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/guardIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/guardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/inkColor"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/guardSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/subColor"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/guardSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <View
        android:id="@+id/guardDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/lineColor" />
</LinearLayout>
