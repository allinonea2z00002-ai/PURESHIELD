<?xml version="1.0" encoding="utf-8"?>
<!-- Time Lock (TimeLockActivity). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Animated background: per-theme decor + drifting clouds / sun
         (SceneryView). The old flat ?attr/appBackground root paint is
         gone; the theme windowBackground still supplies the base colour
         during transitions. -->
    <com.pureshield.app.ui.widget.SceneryView
        android:id="@+id/sceneryView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/displayFontFamily"
                android:text="@string/timelock_title"
                android:textColor="?attr/inkColor"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/timelock_sub"
                android:textColor="?attr/subColor"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.5" />

            <!-- Setup card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/setupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/cardBackground"
                app:cardCornerRadius="?attr/cardCornerRadius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/lineColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/timelock_duration_label"
                        android:textColor="?attr/inkColor"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chip1"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:stateListAnimator="@null"
                            android:textAllCaps="false"
                            android:textColor="@color/chip_text"
                            android:textSize="15sp"
                            app:backgroundTint="@color/chip_background"
                            app:elevation="0dp"
                            app:strokeColor="@color/chip_stroke"
                            app:strokeWidth="1.5dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chip3"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:stateListAnimator="@null"
                            android:textAllCaps="false"
                            android:textColor="@color/chip_text"
                            android:textSize="15sp"
                            app:backgroundTint="@color/chip_background"
                            app:elevation="0dp"
                            app:strokeColor="@color/chip_stroke"
                            app:strokeWidth="1.5dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chip10"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:stateListAnimator="@null"
                            android:textAllCaps="false"
                            android:textColor="@color/chip_text"
                            android:textSize="15sp"
                            app:backgroundTint="@color/chip_background"
                            app:elevation="0dp"
                            app:strokeColor="@color/chip_stroke"
                            app:strokeWidth="1.5dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chip30"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:stateListAnimator="@null"
                            android:textAllCaps="false"
                            android:textColor="@color/chip_text"
                            android:textSize="15sp"
                            app:backgroundTint="@color/chip_background"
                            app:elevation="0dp"
                            app:strokeColor="@color/chip_stroke"
                            app:strokeWidth="1.5dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chip60"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:stateListAnimator="@null"
                            android:textAllCaps="false"
                            android:textColor="@color/chip_text"
                            android:textSize="15sp"
                            app:backgroundTint="@color/chip_background"
                            app:elevation="0dp"
                            app:strokeColor="@color/chip_stroke"
                            app:strokeWidth="1.5dp" />
                    </LinearLayout>

                    <!-- Custom time + min note in one row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/customEdit"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input"
                            android:gravity="center_vertical"
                            android:hint="@string/timelock_custom_hint"
                            android:inputType="number"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:textColor="?attr/inkColor"
                            android:textColorHint="?attr/subColor"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:singleLine="true"
                            android:text="@string/timelock_min_note"
                            android:textColor="?attr/subColor"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/timelock_repeat_label"
                        android:textColor="?attr/inkColor"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/dayRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/timelock_combine_title"
                                android:textColor="?attr/inkColor"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/timelock_combine_sub"
                                android:textColor="?attr/subColor"
                                android:textSize="13sp"
                                android:lineSpacingMultiplier="1.35" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/combineSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Start button (inside the setup card) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/startButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_button_gradient"
                        android:text="@string/timelock_start"
                        android:textColor="?attr/buttonText"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:icon="@drawable/ic_lock"
                        app:iconTint="?attr/buttonText" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Running card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/runningCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/cardBackground"
                app:cardCornerRadius="?attr/cardCornerRadius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/lineColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/runningDot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_pin_dot"
                            android:backgroundTint="?attr/redColor" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/timelock_running"
                            android:textColor="?attr/redColor"
                            android:textSize="15sp"
                            android:letterSpacing="0.04"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/countdownText"
                        android:fontFeatureSettings="tnum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="?attr/displayFontFamily"
                        android:gravity="center"
                        android:text="১০:০০"
                        android:textColor="?attr/inkColor"
                        android:textSize="52sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/endsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textColor="?attr/subColor"
                        android:textSize="13sp" />

                    <ProgressBar
                        android:id="@+id/lockProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="12dp"
                        android:max="1000"
                        android:progressDrawable="@drawable/bg_progress_fill" />

                    <!-- Footer labels, spread across -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/timelock_footer_power"
                            android:textColor="?attr/subColor"
                            android:textSize="12.5sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/timelock_footer_uninstall"
                            android:textColor="?attr/subColor"
                            android:textSize="12.5sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/timelock_footer_install"
                            android:textColor="?attr/subColor"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <!-- Emergency unlock (inside the running card) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/emergencyButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_button_ghost_red"
                        android:text="@string/timelock_emergency"
                        android:textColor="?attr/redColor"
                        android:textSize="15sp"
                        app:backgroundTint="@null"
                        app:icon="@drawable/ic_key"
                        app:iconTint="?attr/redColor" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/timelock_pin_hint"
                        android:textColor="?attr/subColor"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- What's closed while locked -->
            <TextView
                android:id="@+id/whileTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="?attr/displayFontFamily"
                android:text="@string/timelock_while_title"
                android:textColor="?attr/inkColor"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/lockRowsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/cardBackground"
                app:cardCornerRadius="?attr/cardCornerRadius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/lineColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/lockList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp" />
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/include_bottom_nav" />
    </LinearLayout>
</FrameLayout>
