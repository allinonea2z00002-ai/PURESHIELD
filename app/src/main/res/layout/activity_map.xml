<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/back_desc"
            android:gravity="center"
            android:text="‹"
            android:textColor="?attr/inkColor"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/tvMapTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="?attr/displayFontFamily"
            android:text="@string/map_title"
            android:textColor="?attr/inkColor"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSatellite"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/map_satellite"
            android:textColor="?attr/mintDeepColor"
            app:strokeColor="?attr/mintColor" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMapBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/map_lock_open"
        android:textColor="?attr/subColor"
        android:textSize="14sp"
        android:textStyle="bold" />

    <WebView
        android:id="@+id/webMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvMapInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/map_tap_hint"
            android:textColor="?attr/inkColor"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMapDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/map_no_zones"
            android:textColor="?attr/subColor"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMyLocation"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/map_my_location"
                android:textColor="?attr/mintDeepColor"
                app:strokeColor="?attr/mintColor" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddZone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/map_add_zone"
                android:textColor="?attr/buttonText"
                android:visibility="gone"
                app:backgroundTint="?attr/mintDeepColor" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutEditZone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRadiusValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?attr/mintDeepColor"
                android:textSize="15sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:id="@+id/rowRadiusChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveZone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/map_save_zone"
                    android:textColor="?attr/buttonText"
                    app:backgroundTint="?attr/mintDeepColor" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteZone"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/map_delete_zone"
                    android:textColor="?attr/redColor"
                    app:strokeColor="?attr/redColor" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
