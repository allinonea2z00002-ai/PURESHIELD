<?xml version="1.0" encoding="utf-8"?>
<!-- Block screen (BlockActivity): shown by the accessibility service when a
     blocked app/site opens while locked. No bottom nav; not dismissible by
     Back while locked (see BlockActivity). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Animated background: per-theme decor + drifting clouds / sun
         (SceneryView). The old flat ?attr/appBackground root paint is
         gone; the theme windowBackground still supplies the base colour
         during transitions. -->
    <com.pureshield.app.ui.widget.SceneryView
        android:id="@+id/sceneryView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

    <FrameLayout
        android:id="@+id/shieldTile"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_shield_tile">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo_splash" />
    </FrameLayout>

    <TextView
        android:id="@+id/blockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="?attr/displayFontFamily"
        android:gravity="center"
        android:textColor="?attr/inkColor"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/blockscreen_remaining"
        android:textColor="?attr/subColor"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/remainingText"
        android:fontFeatureSettings="tnum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="?attr/displayFontFamily"
        android:text="০০:০০"
        android:textColor="?attr/inkColor"
        android:textSize="40sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/emergencyButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_ghost_red"
        android:text="@string/blockscreen_emergency"
        android:textColor="?attr/redColor"
        android:textSize="15sp"
        app:backgroundTint="@null"
        app:icon="@drawable/ic_key"
        app:iconTint="?attr/redColor" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/homeButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_gradient"
        android:text="@string/blockscreen_home"
        android:textColor="?attr/buttonText"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:icon="@drawable/ic_home"
        app:iconTint="?attr/buttonText" />
    </LinearLayout>
</FrameLayout>
