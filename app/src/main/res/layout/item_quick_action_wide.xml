<?xml version="1.0" encoding="utf-8"?>
<!-- Quick action button, wide variant (Ocean theme, 2 columns): horizontal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/qaIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_tile"
        android:padding="8dp"
        app:tint="?attr/mintColor" />

    <TextView
        android:id="@+id/qaLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:maxLines="1"
        android:textColor="?attr/inkColor"
        android:textSize="14sp" />
</LinearLayout>
