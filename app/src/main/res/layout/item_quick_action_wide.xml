<?xml version="1.0" encoding="utf-8"?>
<!-- Quick action button, wide variant (Ocean theme, 2 columns): horizontal.
     The button is a card (demo .qa): card background, 1px line border,
     theme button radius. The icon tile background/tint are set in code
     (per-action colour at ~13% alpha). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    app:cardBackgroundColor="?attr/cardBackground"
    app:cardCornerRadius="?attr/buttonCornerRadius"
    app:cardElevation="0dp"
    app:strokeColor="?attr/lineColor"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/qaIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/qaLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="?attr/inkColor"
            android:textSize="14sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
